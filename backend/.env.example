# Copy to backend/.env and fill in. Empty values fall back to offline/mock behaviour.

# ---- Supabase (Project Settings → API) ----
# Leave SUPABASE_URL empty to use the in-memory database (data is lost on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy HS256 JWT secret (newer projects use JWKS, no secret needed)
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=post-images

# ---- Gemini (https://aistudio.google.com/apikey) ----
# Empty key → mock AI output.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- Mock switches for development ----
MOCK_AI=false
# true: Threads/IG publishing is simulated, "connect" binds a demo account instantly
MOCK_PUBLISH=true
# true: accept `X-Dev-User: <any id>` instead of a JWT (ignored when SUPABASE_URL is set)
DEV_AUTH=true

# ---- App ----
# Long random string; signs the OAuth state parameter
APP_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://127.0.0.1:5173
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ---- Threads API (Meta app → Threads use case) ----
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://127.0.0.1:8000/api/accounts/threads/callback

# ---- Instagram API with Instagram Login ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/api/accounts/instagram/callback
INSTAGRAM_API_VERSION=v23.0

# ---- Background jobs ----
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
