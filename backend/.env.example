# Copy to backend/.env and fill in. Empty values fall back to offline/mock behaviour.

# ---- Supabase (Project Settings → API) ----
# Leave SUPABASE_URL empty to use the in-memory database (data is lost on restart).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy HS256 JWT secret (newer projects use JWKS, no secret needed)
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=post-images

# ---- Text: TAIWAN AI RAP (https://portal.genai.nchc.org.tw) ----
# OpenAI-compatible. Empty key → mock copy. List model IDs: GET {RAP_BASE_URL}/models
RAP_API_KEY=
RAP_BASE_URL=https://portal.genai.nchc.org.tw/api/v1
RAP_TEXT_MODEL=gemma-4-31B-it

# ---- Card background image: FLUX.1 [schnell] on fal.ai (https://fal.ai/dashboard/keys) ----
# About US$0.003 per image. Empty key → plain gradient background.
FAL_API_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
# 「AI 融合」: restyle a real news photo with FLUX image-to-image (same key, ~US$0.025/image)
FAL_BLEND_MODEL=fal-ai/flux/dev/image-to-image
FAL_BLEND_STRENGTH=0.82

# ---- News / trend search with pictures (趨勢情報、真實圖片) ----
# auto: Tavily when TAVILY_API_KEY is set (https://app.tavily.com), else the free Bing News RSS
# feed; mock: demo results without network; off: disabled
SEARCH_BACKEND=auto
TAVILY_API_KEY=
# Bing News markets (comma separated): every market is searched and results are interleaved
SEARCH_MARKET=zh-TW,en-US

# ---- Mock switches for development ----
MOCK_AI=false
# true: Threads/IG publishing is simulated, "connect" binds a demo account instantly
MOCK_PUBLISH=true
# true: accept `X-Dev-User: <any id>` instead of a JWT (ignored when SUPABASE_URL is set)
DEV_AUTH=true

# ---- App ----
# Long random string; signs the OAuth state parameter
APP_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://127.0.0.1:5173
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ---- Threads API (Meta app → Threads use case) ----
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://127.0.0.1:8000/api/accounts/threads/callback

# ---- Instagram API with Instagram Login ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/api/accounts/instagram/callback
INSTAGRAM_API_VERSION=v23.0

# ---- LinkedIn (https://www.linkedin.com/developers/apps) ----
# Products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Scopes used: openid profile w_member_social. Posts go to the member's own feed.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/api/accounts/linkedin/callback
LINKEDIN_API_VERSION=202605

# ---- Background jobs ----
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30
