# Copy to deploy/.env.production (git-ignored), fill in, then upload it as ONE SSM SecureString:
#   aws ssm put-parameter --name /social-api/env --type SecureString --overwrite --value file://deploy/.env.production
# <API> = the stack's ApiUrl output WITHOUT the trailing slash, <SITE> = SiteUrl output.

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=post-images

RAP_API_KEY=
RAP_BASE_URL=https://portal.genai.nchc.org.tw/api/v1
RAP_TEXT_MODEL=gemma-4-31B-it
FAL_API_KEY=
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_BLEND_MODEL=fal-ai/flux/dev/image-to-image
FAL_BLEND_STRENGTH=0.82
SEARCH_BACKEND=auto
TAVILY_API_KEY=
SEARCH_MARKET=zh-TW,en-US

MOCK_AI=false
MOCK_PUBLISH=false
# production: always false (real Supabase login only)
DEV_AUTH=false

# python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=<SITE>
PUBLIC_BASE_URL=<API>
CORS_ORIGINS=["<SITE>"]

THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=<API>/api/accounts/threads/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=<API>/api/accounts/instagram/callback
INSTAGRAM_API_VERSION=v23.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=<API>/api/accounts/linkedin/callback
LINKEDIN_API_VERSION=202605

PUBLISH_STALE_MINUTES=15
PUBLISH_TRANSIENT_RETRIES=2
PUBLISH_RETRY_BACKOFF_SECONDS=2
TOKEN_REFRESH_DAYS=7
