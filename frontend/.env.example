# Copy to .env.local and fill in. Leave VITE_SUPABASE_URL empty for dev mode
# (no login; the backend must then run with DEV_AUTH=true and no SUPABASE_URL).
VITE_API_BASE=http://127.0.0.1:8000
VITE_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (safe to expose in the browser)
VITE_SUPABASE_PUBLISHABLE_KEY=
